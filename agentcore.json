{
  "name": "prode-mundial-2026",
  "entrypoint": "agent/main.py",
  "requirements_file": "requirements-agent.txt",
  "environment_variables": {
    "DYNAMODB_TABLE":    "ProdeTable-dev",
    "AWS_REGION":        "us-east-1",
    "LOG_LEVEL":         "INFO",
    "GUARDRAIL_ID":      "",
    "GUARDRAIL_VERSION": ""
  },
  "guardrail_config": {
    "guardrail_id":      "{{SSM:/prode-mundial/dev/guardrail_id}}",
    "guardrail_version": "{{SSM:/prode-mundial/dev/guardrail_version}}",
    "trace":             "enabled"
  },
  "secrets": [
    "SCALONIA_TELEGRAM_BOT_TOKEN",
    "TEAMS_WEBHOOK_URL",
    "BEDROCK_KB_ID",
    "AURORA_READER_SECRET_ARN"
  ],
  "observability": {
    "cloudwatch_enabled":         true,
    "transaction_search_enabled": true,
    "xray_enabled":               true
  }
}
