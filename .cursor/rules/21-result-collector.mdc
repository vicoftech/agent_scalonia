## result_service.py — lógica central

```python
# src/services/result_service.py

class ResultService:

    def collect_result(self, match_id: str) -> MatchResult | None:
        """
        Punto de entrada principal. Obtiene el resultado completo de un partido.

        Orden de resolución:
        1. MATCH#/RESULT ya existe y está completo (mvp_name no None) → retornar
        2. MATCH#/RESULT existe pero falta mvp_name → enriquecer con web_search
        3. MATCH#/RESULT no existe → obtener via web_search → guardar → retornar
        4. Si web_search no tiene el resultado aún → retornar None (partido en curso)
        """
        existing = result_dao.get_result(match_id)

        if existing and existing.mvp_name:
            return existing                          # completo → nada que hacer

        if existing and not existing.mvp_name:
            return self._enrich_mvp(match_id, existing)  # agregar MVP

        # No existe → obtener completo via web_search
        match = match_dao.get(match_id)
        result = self._fetch_via_web_search(match)
        if result:
            self._save_and_notify(match_id, result)
        return result

    def _fetch_via_web_search(self, match: dict) -> MatchResult | None:
        """
        Obtiene el resultado completo via web_search.
        Retorna None si el partido no terminó aún.
        """
        home = match["home_team"]
        away = match["away_team"]

        # Verificar si el partido ya debería haber terminado
        kickoff = datetime.fromisoformat(match["kickoff_utc"])
        estimated_end = kickoff + timedelta(minutes=110)
        if datetime.now(tz=timezone.utc) < estimated_end:
            logger.info("Partido %s vs %s aún en curso o no iniciado", home, away)
            return None

        # Buscar resultado
        query = f"{home} vs {away} resultado final Copa Mundial 2026"
        raw = web_search_tool(query)
        if not raw:
            return None

        return self._parse_web_result(raw, match)

    def _parse_web_result(self, raw: str, match: dict) -> MatchResult | None:
        """
        Parsea el texto de web_search para extraer el MatchResult.
        Usa el LLM para interpretar el resultado de forma robusta.
        """
        parse_prompt = f"""
Extraé el resultado del siguiente partido de fútbol del texto.
Partido: {match['home_team']} vs {match['away_team']}
Texto: {raw[:2000]}

Respondé SOLO en JSON con este formato exacto:
{{
  "found": true | false,
  "home_goals": <int>,
  "away_goals": <int>,
  "status": "FT" | "AET" | "PEN",
  "playoff_winner": "<código FIFA>" | null,
  "scorers": {{"<jugador>": <goles>, ...}},
  "red_cards": <int>,
  "mvp_name": "<nombre>" | null
}}

Si no encontraste el resultado, retorná {{"found": false}}.
"""
        response = llm_client.complete(parse_prompt)
        data = json.loads(response)

        if not data.get("found"):
            return None

        return MatchResult(
            home_goals     = data["home_goals"],
            away_goals     = data["away_goals"],
            phase          = match["phase"],
            playoff_via    = _resolve_via(data["status"]),
            playoff_winner = data.get("playoff_winner"),
            scorers        = data.get("scorers", {}),
            red_cards      = data.get("red_cards", 0),
            mvp_name       = data.get("mvp_name"),
        )

    def _enrich_mvp(self, match_id: str, existing: MatchResult) -> MatchResult:
        """
        Completa mvp_name en un resultado que ya tiene los goles.
        Solo busca el MVP — no toca el resto del resultado.
        """
        match = match_dao.get(match_id)
        query = f"jugador del partido {match['home_team']} vs {match['away_team']} Copa Mundial 2026 MVP"
        raw = web_search_tool(query)
        if not raw:
            return existing

        mvp = self._extract_mvp(raw)
        if mvp:
            result_dao.update_mvp(match_id, mvp)
            return MatchResult(**{**existing.__dict__, "mvp_name": mvp})

        return existing

    def _save_and_notify(self, match_id: str, result: MatchResult) -> None:
        """
        Guarda el resultado en MATCH#/RESULT, notifica a usuarios
        y encola el scoring.
        """
        # 1. Guardar resultado (idempotente)
        result_dao.save_result(match_id, result)

        # 2. Actualizar status del partido
        match_dao.update_status(match_id, result.status)

        # 3. Notificar a todos los grupos con predicciones
        self._notify_all_groups(match_id, result)

        # 4. Encolar scoring en SQS
        sqs.send_message(ScoringQueue, {
            "event_type": "FINISH_MATCH",
            "match_id":   match_id,
            "result":     result.to_dict(),
        })

    def _notify_all_groups(self, match_id: str, result: MatchResult) -> None:
        """
        Envía el resultado final a todos los grupos que tienen
        al menos un miembro con predicción del partido.
        Fire-and-forget via SQS NotificationQueue.
        """
        groups = prediction_dao.get_groups_with_predictions(match_id)
        match = match_dao.get(match_id)

        for group in groups:
            members = group_dao.list_members_with_notifications(group.group_id)
            for member in members:
                sqs.send_message(NotificationQueue, {
                    "type":       "MATCH_RESULT",
                    "user_id":    member.user_id,
                    "match_id":   match_id,
                    "group_id":   group.group_id,
                    "result":     result.to_dict(),
                    "match_info": match,
                })
```

