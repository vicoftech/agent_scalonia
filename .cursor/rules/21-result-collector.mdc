## result_collector Lambda — activación automática

```python
# infrastructure/lambdas/result_collector/handler.py

def handler(event, context):
    """
    Se activa de tres formas:
    A) EventBridge rule: cada 5 min, busca partidos que debieron haber terminado
    B) SQS directamente desde match_poller cuando detecta FT/AET/PEN
    C) Invocación manual via CLI: python scripts/collect_result.py --match ARG-ALG
    """
    trigger = event.get("trigger", "scheduled")

    if trigger == "scheduled":
        # Buscar partidos que terminaron y no tienen MATCH#/RESULT completo
        candidates = _find_incomplete_results()
        for match_id in candidates:
            try:
                result = result_service.collect_result(match_id)
                if result:
                    logger.info("Resultado obtenido: %s", match_id[:8])
            except Exception as e:
                logger.error("Error: %s %s", match_id[:8], e)

    elif trigger == "match_ended":
        # Directo desde match_poller — el resultado ya está en MATCH#/RESULT
        # pero puede faltar el MVP → enriquecer
        match_id = event["match_id"]
        result_service.collect_result(match_id)

    elif trigger == "manual":
        match_id = event["match_id"]
        result = result_service.collect_result(match_id)
        logger.info("Manual: %s → %s", match_id[:8], result)

def _find_incomplete_results() -> list[str]:
    """
    Busca partidos que:
    1. Tienen kickoff_utc + 110min < now() (ya deberían haber terminado)
    2. No tienen MATCH#/RESULT o tienen mvp_name=None
    3. status != FT/AET/PEN en MATCH#/DETAILS
    """
    now = datetime.now(tz=timezone.utc)
    cutoff = now - timedelta(minutes=110)
    matches = match_dao.get_matches_finished_before(cutoff)
    return [
        m["match_id"] for m in matches
        if not result_dao.is_complete(m["match_id"])
    ]
```

