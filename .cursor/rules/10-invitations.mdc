## invitation_service.py — lógica de negocio

```python
# src/services/invitation_service.py

class InvitationService:

    def create_invitation(
        self, creator_user_id: str, max_uses: int = 1
    ) -> dict:
        """
        Crea una invitación. Valida cupo disponible antes de crear.
        Retorna el dict con invite_id, link y expires_at.

        Para admin global: group_id = "GLOBAL", sin límite.
        Para owner FREE: group_id = su grupo, max_uses limitado a slots disponibles.
        """

    def validate_and_use(
        self, invite_id: str, new_user_id: str
    ) -> dict:
        """
        Valida la invitación y la consume atómicamente.

        Pasos:
        1. GetItem INVITE#<invite_id>/DETAILS
        2. Verificar status=ACTIVE
        3. Verificar expires_at > now()
        4. UpdateItem: uses_count += 1 (ADD atómico)
           ConditionExpression: uses_count < max_uses AND status = ACTIVE
        5. Si uses_count == max_uses: status → EXHAUSTED
        6. Crear INVITE_USE# para accountability
        7. Crear membresías: grupo destino + GLOBAL
        8. Si EXHAUSTED: disparar notificación al admin (async SQS)

        Retorna: {group_id, group_name, is_new_group_member, is_global_member}
        """

    def revoke_invitation(
        self, invite_id: str, revoker_user_id: str
    ) -> bool:
        """
        Solo el creador de la invitación o el admin global puede revocarla.
        UpdateItem status=REVOKED con ConditionExpression status=ACTIVE.
        """

    def list_my_invitations(
        self, user_id: str, status_filter: str = None
    ) -> list[dict]:
        """
        Query GSI-5-invites-by-creator para listar invitaciones del usuario.
        Filtra opcionalmente por status (ACTIVE, EXHAUSTED, EXPIRED, REVOKED).
        """

    def get_invitation_uses(
        self, invite_id: str, requester_user_id: str
    ) -> list[dict]:
        """
        Solo el creador o el admin pueden ver los usos de una invitación.
        Query GSI-6-invite-uses-by-invite.
        """

    def _check_creator_quota(
        self, creator_user_id: str, max_uses: int
    ) -> tuple[bool, str]:
        """
        Para owners FREE: verifica que max_uses <= slots libres del grupo.
        slots_libres = max_members - current_members.
        Para admin: siempre True.
        """
```

