## Bootstrap del admin global — script de un solo uso

```python
# scripts/bootstrap_admin.py
"""
Uso: python scripts/bootstrap_admin.py --chat-id 123456789 --env staging

Qué hace:
1. Genera UUID como user_id del admin
2. Crea USER#<uuid>/PROFILE en DynamoDB con is_admin=True, status=ACTIVE,
   tier=FREE, platform=TELEGRAM, platform_id_hash=SHA256(chat_id)
3. Agrega membresía al grupo GLOBAL (GROUP#GLOBAL/MEMBER#<uuid>)
4. Guarda admin_user_id en SSM Parameter Store: /prode-mundial/{env}/admin_user_id
5. Guarda admin_platform_id_hash en SSM: /prode-mundial/{env}/admin_platform_id_hash

Idempotente: si el admin ya existe (check por platform_id_hash), actualiza SSM
y retorna sin duplicar.

NUNCA almacena el chat_id en texto plano — solo el SHA-256.
"""
import argparse
import hashlib
import logging
from uuid import uuid4

import boto3

logging.basicConfig(level=logging.INFO, format="%(levelname)s | %(message)s")
logger = logging.getLogger(__name__)


def bootstrap(chat_id: int, env: str) -> None:
    dynamodb = boto3.resource("dynamodb")
    ssm      = boto3.client("ssm")
    table    = dynamodb.Table(f"ProdeTable-{env}")

    platform_id_hash = hashlib.sha256(str(chat_id).encode()).hexdigest()

    # Verificar si ya existe
    existing = table.query(
        IndexName="GSI-1-platform",
        KeyConditionExpression=(
            boto3.dynamodb.conditions.Key("platform").eq("TELEGRAM") &
            boto3.dynamodb.conditions.Key("platform_id_hash").eq(platform_id_hash)
        ),
        Limit=1,
    )
    if existing.get("Items"):
        admin_user_id = existing["Items"][0]["user_id"]
        logger.info("Admin ya existe con user_id=%s — actualizando SSM", admin_user_id[:8])
    else:
        admin_user_id = str(uuid4())
        table.put_item(Item={
            "partition_key":     f"USER#{admin_user_id}",
            "sort_key":          "PROFILE",
            "user_id":           admin_user_id,
            "alias":             "Admin",
            "platform":          "TELEGRAM",
            "platform_id_hash":  platform_id_hash,
            "status":            "ACTIVE",
            "tier":              "FREE",
            "is_admin":          True,
            "groups_owned":      0,
            "invites_sent":      0,
            "onboarding_stage":  "M3_COMPLETE",   # admin no necesita onboarding
            "created_at":        __import__("datetime").datetime.now(
                                     tz=__import__("datetime").timezone.utc
                                 ).isoformat(),
        })
        # Membresía al GLOBAL
        table.put_item(Item={
            "partition_key": "GROUP#GLOBAL",
            "sort_key":      f"MEMBER#{admin_user_id}",
            "group_id":      "GLOBAL",
            "user_id":       admin_user_id,
            "joined_at":     __import__("datetime").datetime.now(
                                 tz=__import__("datetime").timezone.utc
                             ).isoformat(),
        })
        logger.info("Admin creado con user_id=%s", admin_user_id[:8])

    # Guardar en SSM
    for name, value in [
        (f"/prode-mundial/{env}/admin_user_id",          admin_user_id),
        (f"/prode-mundial/{env}/admin_platform_id_hash", platform_id_hash),
    ]:
        ssm.put_parameter(Name=name, Value=value, Type="String", Overwrite=True)
        logger.info("SSM actualizado: %s", name)

    logger.info("Bootstrap completado. El admin puede abrir el bot y empezar a usarlo.")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--chat-id", type=int, required=True,
                        help="Telegram chat_id del admin (se hashea con SHA-256)")
    parser.add_argument("--env", default="staging", choices=["staging", "prod"])
    args = parser.parse_args()
    bootstrap(args.chat_id, args.env)
```

