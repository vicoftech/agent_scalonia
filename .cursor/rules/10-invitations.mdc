_invoke_agent(user_id, session_id, text)
```

```python
# infrastructure/lambdas/telegram_webhook/start_handler.py

def handle_start_command(chat_id: int, text: str) -> str:
    """
    Maneja /start con o sin payload de invitación.
    Retorna el mensaje de respuesta para el usuario.
    """
    invite_id = parse_start_payload(text)   # None si no hay payload

    platform_id_hash = hashlib.sha256(str(chat_id).encode()).hexdigest()
    existing_user = user_dao.get_by_platform_hash("TELEGRAM", platform_id_hash)

    if existing_user:
        if existing_user["status"] != "ACTIVE":
            return INACTIVE_USER_MESSAGE  # genérico, sin LLM
        return f"¡Hola de nuevo, {existing_user.alias}! Ya estás registrado."

    if invite_id:
        # Usuario nuevo con invitación
        invite = invitation_dao.get(invite_id)

        if not invite or invite["status"] != "ACTIVE":
            return ("Esta invitación ya no está vigente. "
                    "Pedile a quien te la mandó que genere una nueva.")

        if invite["expires_at"] < datetime.now(tz=timezone.utc).isoformat():
            invitation_dao.update_status(invite_id, "EXPIRED")
            return "Esta invitación expiró (tenía 24hs de vigencia). Pedí una nueva."

        # Crear usuario y consumir la invitación
        new_user_id = str(uuid4())
        user_dao.create(new_user_id, platform="TELEGRAM",
                        platform_id_hash=platform_id_hash)
        result = invitation_service.validate_and_use(invite_id, new_user_id)
        # El onboarding M1 se dispara desde el agente en la siguiente invocación
        return f"¡Bienvenido al Prode Mundial 2026! Te uniste al grupo {result['group_name']}."

    else:
        # Usuario nuevo sin invitación — solo entra al GLOBAL
        new_user_id = str(uuid4())
        user_dao.create(new_user_id, platform="TELEGRAM",
                        platform_id_hash=platform_id_hash)
        group_dao.add_member("GLOBAL", new_user_id)
        return "¡Bienvenido al Prode Mundial 2026! Entraste al grupo general."
```

