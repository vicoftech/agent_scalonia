## kb_enrichment_service.py — lógica completa

```python
# src/kb/kb_enrichment_service.py

class KBEnrichmentService:

    def enrich_from_web(
        self,
        query: str,
        web_result: str,
        data_type: DataType,
    ) -> None:
        """
        Persiste el resultado de web_search según el tipo de dato.
        Fire-and-forget — el agente no espera esta operación.
        """
        if data_type == DataType.HISTORICAL:
            self._enrich_kb(query, web_result)
        else:
            self._enrich_cache(query, web_result)

    def _enrich_kb(self, query: str, content: str) -> None:
        """
        Genera un documento .md a partir del resultado web y lo sube a S3.
        El kb_sync Lambda detecta el PutObject y dispara StartIngestionJob.

        Formato del documento generado:
          s3://bucket/enriched/{yyyy-mm-dd}/{query_slug}.md
        """
        slug      = self._make_slug(query)
        date_str  = datetime.now(tz=timezone.utc).strftime("%Y-%m-%d")
        s3_key    = f"enriched/{date_str}/{slug}.md"
        markdown  = self._build_markdown(query, content)

        s3 = boto3.client("s3")
        s3.put_object(
            Bucket=self._kb_bucket,
            Key=s3_key,
            Body=markdown.encode("utf-8"),
            ContentType="text/markdown",
            Metadata={
                "source":     "web_search_enrichment",
                "query":      query[:200],
                "created_at": datetime.now(tz=timezone.utc).isoformat(),
            },
        )
        # kb_sync Lambda se dispara automáticamente por el S3 trigger
        logger.info("KB enrichment: subido s3://%s/%s", self._kb_bucket, s3_key)

    def _enrich_cache(self, query: str, content: str, ttl_seconds: int = None) -> None:
        """
        Guarda en DynamoDB CACHE# con TTL según el tipo de contenido.
        Usa la lógica de TTL ya definida en web_search_tool.
        """
        cache_key   = _make_cache_key(query)
        ttl_seconds = ttl_seconds or _TTL["general"]
        _save_to_cache(cache_key, query, content, ttl_seconds)

    def _build_markdown(self, query: str, content: str) -> str:
        """
        Construye un documento Markdown estructurado para Bedrock KB.
        El formato respeta el template estándar de la KB para chunking consistente.
        """
        return f"""# {query.title()}

## Fuente
Obtenido via web search — enriquecimiento dinámico de KB.
Fecha de incorporación: {datetime.now(tz=timezone.utc).strftime("%Y-%m-%d")}

## Contenido

{content}

## Metadata
- query_original: {query}
- tipo: enrichment
- verificar_actualidad: true
"""

    def _make_slug(self, query: str) -> str:
        """query → archivo_slug_seguro_para_s3.md"""
        import re
        slug = re.sub(r"[^a-z0-9\s-]", "", query.lower())
        slug = re.sub(r"\s+", "-", slug.strip())
        return slug[:80] + ".md"

    def should_enrich_kb(self, query: str, kb_result: str | None) -> bool:
        """
        Determina si vale la pena enriquecer la KB con esta query.
        No enriquecer si:
        - La KB ya tiene un resultado suficiente (kb_result es sustancial)
        - La query es demasiado corta o genérica
        - El resultado web es muy corto (probablemente no encontró nada)
        """
        if kb_result and len(kb_result) > 200:
            return False           # KB ya tiene información suficiente
        if len(query.split()) < 3:
            return False           # query demasiado genérica
        return True
```

