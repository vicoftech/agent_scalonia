## Clasificación de queries — histórico vs volátil

### Señales de dato HISTÓRICO → persiste en S3 + KB

```python
HISTORICAL_SIGNALS = [
    # Temporales
    r"\b(19[3-9]\d|20[0-2][0-9])\b",   # año entre 1930 y 2025
    r"\bmundial\s+(de\s+)?(19|20)\d{2}", # "mundial de 1986"
    r"\b(primer|último|histórico|record|all.time)\b",

    # Entidades cerradas
    r"\bjugador\s+retirado\b",
    r"\b(pelé|maradona|cruyff|beckenbauer|zidane|ronaldo nazario)\b",

    # Tipos de contenido estable
    r"\b(regla|ley del juego|táctica|formación|historia de|anécdota|curiosidad)\b",
    r"\b(estadística de carrera|goles en mundiales|partidos jugados)\b",
    r"\b(sede|estadio del mundial [12]\d{3})\b",
]
```

### Señales de dato VOLÁTIL → persiste en DynamoDB CACHE#

```python
VOLATILE_SIGNALS = [
    # Temporales recientes
    r"\b(hoy|ayer|anoche|esta semana|reciente|último partido|ahora)\b",
    r"\b202[6-9]\b",                    # año 2026 en adelante
    r"\b(en vivo|live|minuto a minuto)\b",

    # Tipos de contenido efímero
    r"\b(resultado|marcador|score)\b",
    r"\b(convocatoria|alineación|once titular|titular)\b",
    r"\b(lesión|baja|suspendido|sancionado)\b",
    r"\b(fixture|horario|cuándo juega|próximo partido)\b",
    r"\b(tabla de posiciones|clasificación actual|ranking actual)\b",
    r"\b(noticias?|novedades?|rumores?)\b",
]
```

### Función de clasificación

```python
# src/kb/kb_enrichment_service.py

import re
from enum import Enum

class DataType(Enum):
    HISTORICAL = "historical"   # → S3 + Bedrock KB
    VOLATILE   = "volatile"     # → DynamoDB CACHE#
    AMBIGUOUS  = "ambiguous"    # → DynamoDB CACHE# por defecto (más seguro)

def classify_query(query: str) -> DataType:
    """
    Clasifica la query para determinar dónde persistir el resultado.
    En caso de ambigüedad → VOLATILE (DynamoDB).
    Nunca indexar en Bedrock algo que puede quedar desactualizado.
    """
    q = query.lower()
    historical_score = sum(
        1 for pattern in HISTORICAL_SIGNALS
        if re.search(pattern, q, re.IGNORECASE)
    )
    volatile_score = sum(
        1 for pattern in VOLATILE_SIGNALS
        if re.search(pattern, q, re.IGNORECASE)
    )

    if volatile_score > 0:
        return DataType.VOLATILE      # cualquier señal volátil → cache
    if historical_score >= 2:
        return DataType.HISTORICAL    # al menos 2 señales históricas → KB
    return DataType.AMBIGUOUS         # dudoso → cache (conservador)
```

