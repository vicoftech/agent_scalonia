## Deduplicación — no indexar lo que ya está

```python
def _check_already_enriched(query: str) -> bool:
    """
    Antes de subir a S3, verificar si ya existe un documento similar.
    Usa DynamoDB para llevar registro de slugs ya indexados.

    PK: KB_ENRICHED#<slug>    SK: DETAILS
    TTL: 30 días (después de ese tiempo puede re-enriquecerse)
    """
    table = boto3.resource("dynamodb").Table(DYNAMODB_TABLE)
    slug  = _make_slug(query)
    resp  = table.get_item(Key={
        "partition_key": f"KB_ENRICHED#{slug}",
        "sort_key":      "DETAILS",
    })
    return bool(resp.get("Item"))

def _mark_as_enriched(query: str) -> None:
    """Registra el slug en DynamoDB para evitar duplicados."""
    slug = _make_slug(query)
    now  = int(datetime.now(tz=timezone.utc).timestamp())
    table.put_item(Item={
        "partition_key": f"KB_ENRICHED#{slug}",
        "sort_key":      "DETAILS",
        "query":         query[:200],
        "enriched_at":   datetime.now(tz=timezone.utc).isoformat(),
        "ttl_expiry":    now + (30 * 24 * 3600),   # 30 días
    })
```

