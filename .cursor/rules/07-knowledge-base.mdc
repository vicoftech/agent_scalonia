## web_search_tool — implementación completa

```python
# agent/tools/web_search_tool.py
import hashlib
import json
import logging
import os
from datetime import datetime, timezone
from typing import Optional

import boto3
import httpx
from strands import tool

logger = logging.getLogger(__name__)

DYNAMODB_TABLE = os.environ["DYNAMODB_TABLE"]
_dynamodb = boto3.resource("dynamodb")

# TTLs en segundos según el tipo de consulta
TTL_LIVE_MATCH    = 60 * 10        # 10 minutos — partido en vivo
TTL_RECENT_RESULT = 60 * 60 * 24  # 24 horas — resultado finalizado
TTL_FIXTURE       = 60 * 60 * 6   # 6 horas — horarios
TTL_STATS         = 60 * 60 * 6   # 6 horas — estadísticas
TTL_NEWS          = 60 * 60 * 2   # 2 horas — noticias


@tool
def web_search_tool(
    query: str,
    search_type: str = "general",
) -> str:
    """
    Busca información actualizada sobre fútbol y el Mundial 2026.
    Primero consulta el cache en DynamoDB. Si no hay hit, realiza la búsqueda
    y persiste el resultado según el TTL correspondiente al tipo de búsqueda.

    search_type:
        "live_match"    — partido en vivo (cache 10 min)
        "result"        — resultado finalizado (cache 24h)
        "fixture"       — horarios y fixture (cache 6h)
        "stats"         — estadísticas (cache 6h)
        "news"          — noticias y novedades (cache 2h)
        "general"       — búsqueda general (cache 6h)

    Temas habilitados: fútbol y mundiales FIFA únicamente.
    """
    # 1. Verificar cache
    cache_key = _make_cache_key(query)
    cached = _get_from_cache(cache_key)
    if cached:
        logger.debug("Cache hit: %s", cache_key[:20])
        return cached

    # 2. Determinar TTL según search_type
    ttl_map = {
        "live_match": TTL_LIVE_MATCH,
        "result":     TTL_RECENT_RESULT,
        "fixture":    TTL_FIXTURE,
        "stats":      TTL_STATS,
        "news":       TTL_NEWS,
        "general":    TTL_STATS,
    }
    ttl_seconds = ttl_map.get(search_type, TTL_STATS)

    # 3. Realizar búsqueda
    result = _perform_search(query)

    # 4. Persistir en cache
    if result:
        _save_to_cache(cache_key, query, result, ttl_seconds)

    return result or "No encontré información relevante para esa consulta."


def _make_cache_key(query: str) -> str:
    return "CACHE#" + hashlib.sha256(query.lower().strip().encode()).hexdigest()[:32]


def _get_from_cache(cache_key: str) -> Optional[str]:
    try:
        table = _dynamodb.Table(DYNAMODB_TABLE)
        resp = table.get_item(
            Key={"partition_key": cache_key, "sort_key": "RESULT"}
        )
        item = resp.get("Item")
        if not item:
            return None
        # Verificar que no expiró (DynamoDB TTL puede tardar hasta 48h en eliminar)
        ttl = item.get("ttl_expiry", 0)
        now = int(datetime.now(tz=timezone.utc).timestamp())
        if ttl > 0 and now > ttl:
            return None
        return item.get("result_text")
    except Exception as e:
        logger.warning("Cache read error: %s", type(e).__name__)
        return None


def _save_to_cache(cache_key: str, query: str, result: str, ttl_seconds: int) -> None:
    try:
        table = _dynamodb.Table(DYNAMODB_TABLE)
        now = int(datetime.now(tz=timezone.utc).timestamp())
        table.put_item(Item={
            "partition_key": cache_key,
            "sort_key":      "RESULT",
            "query":         query,
            "result_text":   result[:10000],   # límite 10KB por item
            "cached_at":     datetime.now(tz=timezone.utc).isoformat(),
            "ttl_expiry":    now + ttl_seconds,
        })
    except Exception as e:
        logger.warning("Cache write error: %s", type(e).__name__)


def _perform_search(query: str) -> Optional[str]:
    """
    Realiza la búsqueda web real.
    Implementar con la API de búsqueda disponible (Tavily, Serper, etc.)
    o mediante scraping de fuentes confiables.
    """
