## Infraestructura Terraform — S3 + Bedrock KB

```hcl
# infrastructure/terraform/kb/main.tf

# Bucket S3 para los documentos de la KB
resource "aws_s3_bucket" "kb_documents" {
  bucket = "${var.project_name}-knowledge-base-${var.env}"
  tags = {
    Project     = var.project_name
    Environment = var.env
    ManagedBy   = "terraform"
  }
}

resource "aws_s3_bucket_versioning" "kb_documents" {
  bucket = aws_s3_bucket.kb_documents.id
  versioning_configuration { status = "Enabled" }
}

# Bedrock Knowledge Base
resource "aws_bedrockagent_knowledge_base" "prode_kb" {
  name     = "${var.project_name}-kb-${var.env}"
  role_arn = aws_iam_role.bedrock_kb.arn

  knowledge_base_configuration {
    type = "VECTOR"
    vector_knowledge_base_configuration {
      embedding_model_arn = "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0"
    }
  }

  storage_configuration {
    type = "OPENSEARCH_SERVERLESS"
    opensearch_serverless_configuration {
      collection_arn    = aws_opensearchserverless_collection.kb_vectors.arn
      vector_index_name = "prode-kb-index"
      field_mapping {
        vector_field   = "embedding"
        text_field     = "text"
        metadata_field = "metadata"
      }
    }
  }
}

# Data source — apunta al S3
resource "aws_bedrockagent_data_source" "kb_s3" {
  knowledge_base_id = aws_bedrockagent_knowledge_base.prode_kb.id
  name              = "prode-kb-s3-source"

  data_source_configuration {
    type = "S3"
    s3_configuration {
      bucket_arn = aws_s3_bucket.kb_documents.arn
    }
  }

  vector_ingestion_configuration {
    chunking_configuration {
      chunking_strategy = "FIXED_SIZE"
      fixed_size_chunking_configuration {
        max_tokens         = 1000
        overlap_percentage = 20
      }
    }
  }
}

# Lambda para sincronización automática al hacer push en S3
resource "aws_lambda_function" "kb_sync" {
  function_name = "${var.project_name}-kb-sync-${var.env}"
  handler       = "handler.handler"
  runtime       = "python3.12"
  role          = aws_iam_role.lambda_kb_sync.arn
  timeout       = 300

  environment {
    variables = {
      KNOWLEDGE_BASE_ID = aws_bedrockagent_knowledge_base.prode_kb.id
      DATA_SOURCE_ID    = aws_bedrockagent_data_source.kb_s3.data_source_id
    }
  }
}

# Trigger: S3 PutObject → Lambda kb_sync
resource "aws_s3_bucket_notification" "kb_sync_trigger" {
  bucket = aws_s3_bucket.kb_documents.id
  lambda_function {
    lambda_function_arn = aws_lambda_function.kb_sync.arn
    events              = ["s3:ObjectCreated:*", "s3:ObjectRemoved:*"]
  }
}

# SSM — IDs para el agente
resource "aws_ssm_parameter" "kb_id" {
  name  = "/${var.project_name}/${var.env}/bedrock_kb_id"
  type  = "String"
  value = aws_bedrockagent_knowledge_base.prode_kb.id
}

resource "aws_ssm_parameter" "kb_s3_bucket" {
  name  = "/${var.project_name}/${var.env}/kb_s3_bucket"
  type  = "String"
  value = aws_s3_bucket.kb_documents.bucket
}
```

