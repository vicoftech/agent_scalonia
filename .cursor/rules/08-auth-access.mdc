## Verificación de permisos en las @tools — patrón

```python
# src/services/auth_service.py
class AuthService:
    def check_can_create_group(self, user_id: str) -> tuple[bool, str]:
        """Retorna (allowed, reason). Llama SIEMPRE antes de crear un grupo."""
        user = user_dao.get_profile(user_id)
        if user.is_admin or user.tier == "PRO":
            return True, "ok"
        if user.groups_owned >= 1:
            return False, "LIMIT_REACHED_GROUPS"
        return True, "ok"

    def check_can_invite(self, user_id: str, group_id: str) -> tuple[bool, str]:
        """Retorna (allowed, reason). Llama SIEMPRE antes de generar un código."""
        user  = user_dao.get_profile(user_id)
        group = group_dao.get_group(group_id)
        if user.is_admin:
            return True, "ok"
        if group.owner_id != user_id:
            return False, "NOT_GROUP_OWNER"
        member_count = group_dao.count_members(group_id)
        if member_count >= group.max_members:
            return False, "LIMIT_REACHED_INVITES"
        return True, "ok"

    def is_admin_global(self, user_id: str) -> bool:
        return user_dao.get_profile(user_id).is_admin

    def is_group_owner(self, user_id: str, group_id: str) -> bool:
        return group_dao.get_group(group_id).owner_id == user_id
```

