# cp dev.tfvars.example dev.tfvars
#
# CI (GitHub Actions + OIDC):
#   1) make apply → terraform output github_actions_role_arn → secret AWS_ROLE_ARN_DEV
#   2) Copiar dev.tfvars → secret DEV_TFVARS
#   deploy-dev.yml corre en push a dev/main (agent/, lambdas/, terraform/).
# github_repository = "vicoftech/agent_scalonia"
# enable_github_oidc = true
#
# Orden:
#   1) ./bin/bootstrap.sh      # crea bucket S3 + tabla lock (una vez)
#   2) ./bin/init-backend.sh   # init remoto (NO "terraform init" solo)
#   3) terraform apply -var-file=dev.tfvars
# Plan/apply:
#   terraform plan  -var-file=dev.tfvars
#   terraform apply -var-file=dev.tfvars
#
# Alternativa: copiar a terraform.tfvars (se carga solo, también está en .gitignore).

env                       = "dev"
aws_region                = "us-east-1"
aws_profile               = "asap_dev"
aurora_cluster_identifier = "aurora-pg-dev"

# terraform_state_bucket: ACCOUNT_ID lo resuelve ./bin/init-backend.sh vía aws_profile
terraform_state_bucket     = "prode-terraform-state-ACCOUNT_ID"
terraform_state_lock_table = "prode-terraform-state-lock"
terraform_state_key        = "prode/terraform.tfstate"

# aws secretsmanager describe-secret --secret-id SCALONIA_TELEGRAM_BOT_TOKEN --query ARN --output text
telegram_secret_arn = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:SCALONIA_TELEGRAM_BOT_TOKEN-AbCdEf"

# LLM (cuentas reseller: sin Anthropic). Pro ≈ Sonnet | Lite ≈ Haiku | Llama: us.meta.llama3-3-70b-instruct-v1:0
# bedrock_model_id = "us.amazon.nova-pro-v1:0"

# Guardrails SPEC-2026-015 (opcional)
# sns_alerts_arn = "arn:aws:sns:us-east-1:ACCOUNT_ID:prode-alerts"

# ── Knowledge Base (pgvector) ─────────────────────────────────────────────
# Los chunks viven en:  <db_name>.prode.kb_chunks  (esquema prode, NO public).
# El cluster debe tener ≥1 instancia (db.serverless).
#
# ► TU CUENTA / control total (recomendado si usás DBeaver en ch7yo6tzxi4l):
#    1) aws_profile = TU profile (no asap_dev)
#    2) ./bin/kb-your-aurora-hints.sh aurora-pg-dev   # con AWS_PROFILE=tu_profile
#    3) Completar dev.tfvars y: make apply
#    4) Re-ingestar: aws s3 sync knowledge-base/ s3://$(aws ssm get-parameter ...)
#
# manage_aurora_secret          = true
# aurora_db_username            = "dev_master"
# aurora_db_password            = "..." # sensitive — no commitear
# asap_dev — un solo cluster (postgres @ aurora-pg-asap-dev):
# rds_proxy_endpoint            = "aurora-pg-asap-dev.cluster-cgxq84qu0b72.us-east-1.rds.amazonaws.com"
# db_name                       = "postgres"
# aurora_sync_secret_arn        = "arn:aws:secretsmanager:us-east-1:615216531593:secret:prode-mundial/dev/aurora-sync-XXXX"
# manage_aurora_secret          = false   # password en SM manual (Asap#2026)
# lambda_vpc_subnet_ids         = ["subnet-0778965dc1b21dfb7", "subnet-01ad385e56ce2a2b9"]
# lambda_vpc_security_group_ids = ["sg-0773b50b361cb2068"]      # prode-kb-lambda-asap-dev
# kb_aurora_security_group_id   = "sg-0ff149c197120e05a"
# enable_kb_vpc_endpoints       = true
# kb_ingest_timeout               = 300
# kb_ingest_reserved_concurrency  = 3
#
# ► Cuenta asap_dev (solo si querés datos en cgxq84qu0b72 — sin acceso DBeaver fácil):
# rds_proxy_endpoint            = "aurora-pg-dev.cluster-cgxq84qu0b72.us-east-1.rds.amazonaws.com"
# tavily_secret_arn             = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:TAVILY_API_KEY-xxx"
