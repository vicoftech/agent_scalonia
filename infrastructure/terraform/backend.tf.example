# Copiá a `backend.tf` (no commitear credenciales). Backend remoto obligatorio para CI/CD
# con estado compartido; sin esto cada run del runner tiene estado vacío.
#
# terraform {
#   backend "s3" {
#     bucket         = "tu-org-prode-terraform-state"
#     key            = "scalonia-agent/terraform.tfstate"
#     region         = "us-east-1"
#     encrypt        = true
#     dynamodb_table = "terraform-state-lock"
#   }
# }
#
# init en CI:
#   terraform init -backend-config="bucket=..." -backend-config="key=..." ...
